# Copie este archivo como .env y complete valores locales. Nunca versionar .env.
NODE_ENV=development
PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,saldio://app

# PostgreSQL. En desarrollo puede usar `npm run dev:db` (PostgreSQL embebido).
DATABASE_URL=postgresql://saldio:saldio@localhost:5433/saldio?schema=public
DIRECT_URL=postgresql://saldio:saldio@localhost:5433/saldio?schema=public

# Secreto de firma de sesiones: genere uno con `openssl rand -hex 48`.
JWT_ACCESS_SECRET=cambie-este-secreto-de-desarrollo-por-uno-largo-y-aleatorio
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Clave de 32 bytes en hexadecimal para cifrar configuraciones de integracion.
# Ejemplo de generacion: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_ENCRYPTION_KEY=
FILE_SIGNING_SECRET=cambie-este-secreto-de-firma-de-archivos

# Almacenamiento privado local fuera de la carpeta publica.
STORAGE_DIR=./uploads
MAX_UPLOAD_BYTES=2097152

# Correo. Sin SMTP configurado, los enlaces se guardan en la bandeja de salida.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Saldio POS <no-reply@example.invalid>"

# Bootstrap de administradores. Solo se usan si el mecanismo esta habilitado
# y la base no contiene administradores. No versionar estos valores.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_1_NAME=
BOOTSTRAP_ADMIN_1_USERNAME=
BOOTSTRAP_ADMIN_1_PASSWORD=
BOOTSTRAP_ADMIN_2_NAME=
BOOTSTRAP_ADMIN_2_USERNAME=
BOOTSTRAP_ADMIN_2_PASSWORD=

# Integraciones: sin credenciales se opera en modo prueba.
PAYMENTS_PROVIDER=test
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_MODE=test
FISCAL_PROVIDER=disabled
FISCAL_MODE=test

# Aprobacion automatica de tiendas (false por defecto).
AUTO_APPROVE_STORES=false
SUPPORT_SESSION_MINUTES=30
